    <!-- عروض 365 -->
    <div class="section-title">💰 عرض الفخامة (365 ج)</div>
    <div class="menu-card">
        <div class="item-row">
            <div class="item-name">طاجن ورق عنب بالكوارع + صينية بشاميل + ملوخية</div>
            <span class="item-price">365 ج</span>
        </div>
