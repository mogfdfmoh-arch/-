    <div class="menu-card">
        <div class="item-row"><span class="item-name">بيتزا مارجريتا</span><span class="item-price">صغير 90 ج | كبير 130 ج</span></div>
        <div class="item-row"><span class="item-name">بيتزا خضروات</span><span class="item-price">صغير 95 ج | كبير 130 ج</span></div>
        <div class="item-row"><span class="item-name">بيتزا فراخ</span><span class="item-price">صغير 120 ج | كبير 150 ج</span></div>
