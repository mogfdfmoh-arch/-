    <!-- الأكل الجاهز والسندوتشات -->
    <div class="section-title">🍲 الأكل الجاهز والسندوتشات</div>
    <div class="menu-card">
        <div class="item-row"><span class="item-name">مكرونة بالبشاميل</span><span class="item-price">ص: 70 | و: 120 | ك: 200 ج</span></div>
        <div class="item-row"><span class="item-name">وجبة ربع فرخة مشوية + رز + سلطة</span><span class="item-price">125 ج</span></div>
        <div class="item-row"><span class="item-name">كيلو ممبار مستوي ومحمر</span><span class="item-price">85 ج</span></div>
        <div class="item-row"><span class="item-name">صينية جلاش باللحمة المفرومة</span><span class="item-price">150 ج</span></div>
        <div class="item-row"><span class="item-name">رغيف كبدة اسكندراني</span><span class="item-price">20 ج</span></div>
        <div class="item-row"><span class="item-name">رغيف حواوشي لحمة بلدي</span><span class="item-price">20 ج</span></div>
        <div class="item-row"><span class="item-name">رغيف سجق شرقي</span><span class="item-price">20 ج</span></div>
    </div>

    <!-- زر الاتصال والطلب -->
    <a class="fixed-call-btn" href="https://wa.me/201007472563" target="_blank">
        📱 للطلب عبر الواتساب: 01007472563
