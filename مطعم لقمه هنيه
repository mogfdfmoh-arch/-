    <!-- عروض البيت -->
    <div class="section-title">🏠 عروض البيت (530 ج)</div>
    <div class="menu-card">
        <div class="item-row">
            <div class="item-name">كيلو محشي + فرخة كبيرة مشوية + صينية بشاميل وسط + ملوخية</div>
