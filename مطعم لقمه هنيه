        <div class="item-row">
            <div class="item-name">كيلو محشي + صينية مكرونة بشاميل وسط</div>
            <span class="item-price">230 ج</span>
        </div>
        <div class="item-row">
            <div class="item-name">كيلو محشي + نص ممبار + ملوخية</div>
            <span class="item-price">230 ج</span>
        </div>
        <div class="item-row">
            <div class="item-name">نص ممبار + نص محشي + طاجن بشاميل</div>
            <span class="item-price">230 ج</span>
        </div>
